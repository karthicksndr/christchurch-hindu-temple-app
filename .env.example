# Copy this file to .env and fill in real values. .env is gitignored and
# never committed — see README.md for setup details.

# Deployed URL of the temple-app-notify-server backend's /api/notify
# endpoint. Defaults to the production deployment if left unset.
EXPO_PUBLIC_NOTIFY_API_URL=https://temple-app-notify-server.vercel.app/api/notify

# Optional: must match APP_SHARED_SECRET set on the backend. Leave blank to
# skip sending the x-api-key header.
EXPO_PUBLIC_APP_SHARED_SECRET=

# Share URL of the published Google Sheet used for calendar events (File >
# Share > "Anyone with the link"). Leave blank to use the built-in sample
# events instead.
EXPO_PUBLIC_EVENTS_SHEET_URL=
